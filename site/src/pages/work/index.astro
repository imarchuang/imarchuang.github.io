---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { drops } from "../../data/drops";
---

<BaseLayout
  title="视觉作品 — Marc Huang"
  description="交互图解、视觉实验与学习工具：让复杂系统成为可以探索的体验。"
>
  <article class="landing page-shell">
    <header class="landing-header">
      <p class="kicker">Work / Visual systems</p>
      <h1>让想法拥有可以探索的形状。</h1>
      <p class="lede">这里收集交互图解、视觉实验和小型工具。每一项都尝试把抽象关系转化为直接、清晰的体验。</p>
    </header>
    <div class="card-grid">
      {drops.map((drop, index) => (
        <section class="collection-card">
          <span class="kicker">{drop.kind} / {String(index + 1).padStart(2, "0")}</span>
          <h2>{drop.title}</h2>
          <p>{drop.description}</p>
          <a href={drop.href}>打开作品&nbsp; ↗</a>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
