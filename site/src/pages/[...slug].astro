---
import { getCollection, getEntry, render } from "astro:content";

import ArticleLayout from "../layouts/ArticleLayout.astro";
import { buildArticleRoutes, buildSectionNavigation } from "../lib/articles";
import { getNavigation } from "../lib/navigation";

export async function getStaticPaths() {
  const entries = await getCollection("notes");
  const routes = buildArticleRoutes(entries, getNavigation());

  return routes.map((route) => ({
    params: {
      slug: route.slug,
    },
    props: route,
  }));
}

const route = Astro.props;
const entry = await getEntry("notes", route.entryId);
const navigation = getNavigation();
const articleRoutes = buildArticleRoutes(await getCollection("notes"), navigation);
const sectionNavigation = buildSectionNavigation(
  navigation,
  new Set(articleRoutes.map((item) => item.href)),
);

if (!entry) {
  throw new Error(`Missing note entry "${route.entryId}"`);
}

const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  createdDate={entry.data.createdDate}
  updatedDate={entry.data.updatedDate}
  navigation={sectionNavigation}
  currentPath={route.href}
  headings={headings}
  previous={route.previous}
  next={route.next}
  language={entry.data.language}
>
  <Content />
</ArticleLayout>
