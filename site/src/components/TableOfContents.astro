---
interface HeadingLink {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingLink[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth <= 4);
---

{items.length > 0 && (
  <aside class="article-toc">
    <nav aria-label="文章目录">
      <p class="kicker">On this page</p>
      <h2>文章目录</h2>
      <ul class="article-toc-list">
        {items.map((heading) => (
          <li style={`--toc-depth:${Math.max(heading.depth - 2, 0)}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}
