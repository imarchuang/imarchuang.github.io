---
import type { NavigationSection } from "../lib/navigation";

import SectionNavTree from "./SectionNavTree.astro";

interface Props {
  navigation: NavigationSection[];
  currentPath: string;
}

const { navigation, currentPath } = Astro.props;
const sections = navigation.filter((section) => section.href !== "/");
---

<section class="section-nav" data-section-nav>
  <aside class="section-nav-desktop" data-section-nav-desktop>
    <div class="section-nav-heading">
      <div>
        <p class="kicker">Notes / Sections</p>
        <h2>章节导航</h2>
      </div>
      <button
        type="button"
        class="section-nav-toggle"
        data-section-nav-toggle
        aria-expanded="true"
        aria-controls="section-nav-desktop-panel"
      >
        收起
      </button>
    </div>
    <nav id="section-nav-desktop-panel" aria-label="章节导航">
      <SectionNavTree items={sections} currentPath={currentPath} />
    </nav>
  </aside>

  <div class="section-nav-mobile">
    <button
      type="button"
      class="section-nav-open"
      data-section-nav-open
      aria-controls="section-nav-mobile-dialog"
      aria-haspopup="dialog"
    >
      打开章节导航
    </button>

    <div class="section-nav-fallback">
      <p class="kicker">Notes / Sections</p>
      <nav aria-label="章节导航">
        <SectionNavTree items={sections} currentPath={currentPath} />
      </nav>
    </div>

    <dialog id="section-nav-mobile-dialog" class="section-nav-dialog" aria-label="章节导航">
      <div class="section-nav-dialog-shell">
        <div class="section-nav-heading">
          <div>
            <p class="kicker">Notes / Sections</p>
            <h2>章节导航</h2>
          </div>
          <button type="button" class="section-nav-toggle" data-section-nav-close>
            关闭
          </button>
        </div>
        <nav aria-label="章节导航">
          <SectionNavTree items={sections} currentPath={currentPath} />
        </nav>
      </div>
    </dialog>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-section-nav]");
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const desktop = root.querySelector("[data-section-nav-desktop]");
    const desktopPanel = root.querySelector("#section-nav-desktop-panel");
    const toggle = root.querySelector("[data-section-nav-toggle]");
    const openButton = root.querySelector("[data-section-nav-open]");
    const closeButton = root.querySelector("[data-section-nav-close]");
    const dialog = root.querySelector("#section-nav-mobile-dialog");
    let lastTrigger = null;

    if (
      desktop instanceof HTMLElement &&
      desktopPanel instanceof HTMLElement &&
      toggle instanceof HTMLButtonElement
    ) {
      toggle.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") !== "false";
        const nextExpanded = !expanded;
        toggle.setAttribute("aria-expanded", String(nextExpanded));
        toggle.textContent = nextExpanded ? "收起" : "展开";
        desktop.dataset.collapsed = nextExpanded ? "false" : "true";
        desktopPanel.hidden = !nextExpanded;
      });
    }

    if (
      openButton instanceof HTMLButtonElement &&
      closeButton instanceof HTMLButtonElement &&
      dialog instanceof HTMLDialogElement
    ) {
      openButton.addEventListener("click", () => {
        lastTrigger = openButton;
        if (!dialog.open) {
          dialog.showModal();
        }
      });

      closeButton.addEventListener("click", () => {
        dialog.close();
      });

      dialog.addEventListener("close", () => {
        if (lastTrigger instanceof HTMLElement) {
          lastTrigger.focus();
        }
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });

      dialog.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof HTMLAnchorElement) {
          dialog.close();
        }
      });
    }
  })();
</script>
